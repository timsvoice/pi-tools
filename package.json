{
	"name": "pi-scribe",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:complexity": "eslint . --ext .ts",
		"diff-budget": "node ./scripts/check-diff-budget.mjs",
		"test": "node --test --import tsx $(find tests -name \"*.test.ts\")",
		"promptfoo": "promptfoo eval -c promptfooconfig.yaml",
		"audit": "npm run audit:deps && npm run audit:secrets && npm run audit:sast && npm run audit:sbom",
		"audit:deps": "npm audit --omit=dev",
		"audit:deps:all": "npm audit",
		"audit:secrets": "gitleaks detect --source . --no-git",
		"audit:sast": "semgrep --config=auto",
		"audit:sbom": "cyclonedx-npm --omit dev --output-file sbom/sbom.json",
		"prepare": "husky install"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@cyclonedx/cyclonedx-npm": "^4.2.1",
		"@mariozechner/pi-ai": "^0.61.0",
		"@mariozechner/pi-coding-agent": "^0.61.0",
		"@typescript-eslint/parser": "^7.18.0",
		"eslint": "^8.57.0",
		"fast-check": "^3.22.0",
		"husky": "^9.1.7",
		"promptfoo": "^0.121.2",
		"tsx": "^4.19.2",
		"typescript": "^5.5.4"
	}
}
